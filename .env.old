# Supported values: asterisk, grandstream, freeswitch, yeastar, mock.
# Grandstream UCM aliases include grandstream-ucm and ucm6300.
# GUI aliases are accepted too: freepbx, issabel, vitalpbx, fusionpbx.
PBXSENSE_PBX_TYPE=freeswitch
PBXSENSE_AGENT_MODE=freeswitch
PBXSENSE_DISPLAY_NAME=Asterisk
PBXSENSE_TIMEZONE=Europe/Athens
PBXSENSE_AGENT_TOKEN=ikk9j9Ti8E2ZFQLJ1Pw8qa-54wEN-S3zo25pKh58wuE
PBXSENSE_CONNECT_TIMEOUT=3
PBXSENSE_SNAPSHOT_POLL_SECONDS=1
PBXSENSE_HISTORY_POLL_SECONDS=30
PBXSENSE_ENDPOINT_ACTIVITY_PATH=/var/lib/pbxsense-agent/endpoint_activity.json
# A phone must remain continuously unavailable/available for these periods
# before PBXSense alerts or announces its recovery.
PBXSENSE_ENDPOINT_OUTAGE_CONFIRMATION_SECONDS=30
PBXSENSE_ENDPOINT_RECOVERY_CONFIRMATION_SECONDS=60
PBXSENSE_TRUNK_OUTAGE_CONFIRMATION_SECONDS=5
# Comma-separated PBX endpoint/profile names. Explicit identities are preferred
# over name-based discovery, for example: cosmote-primary,backup-carrier.
PBXSENSE_TRUNK_ENDPOINTS=Cosmote
# Individual unavailable-phone Health Signals are immediate. The aggregate
# multi-phone Tip appears only after this many continuous seconds (default 3m).
PBXSENSE_QUALITY_FREQUENCY_SECONDS=180

# PBXSense Cloud Run push relay. The protected Agent-page QR enrolls this
# installation and its paired phones; no manual claim code is needed.
PBXSENSE_RELAY_URL=https://pbxsense-push-relay-299065188499.europe-west1.run.app
PBXSENSE_INTERNET_RELAY_ENABLED=true
PBXSENSE_INTERNET_RELAY_POLL_SECONDS=15
PBXSENSE_RELAY_IDENTITY_PATH=/var/lib/pbxsense-agent/relay_identity.json
PBXSENSE_RELAY_TIMEOUT=5

# Used by the Linux systemd installer. Docker Compose exposes 8765 directly.
PBXSENSE_AGENT_PORT=8765

# When running Docker Compose on the PBX host, 127.0.0.1 reaches local AMI
# because docker-compose.yml uses network_mode: host.
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=admin
ASTERISK_AMI_PASSWORD=P0k3f4n1989!
ASTERISK_CDR_CSV_PATH=/var/log/asterisk/cdr-custom/Master.csv

# FreeSWITCH Event Socket connector. Used when PBXSENSE_PBX_TYPE=freeswitch.
FREESWITCH_ESL_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon
FREESWITCH_CDR_JSON_PATH=/var/lib/pbxsense-agent/freeswitch-log/json_cdr
FREESWITCH_VOICEMAIL_PATH=/var/lib/pbxsense-agent/freeswitch/storage/voicemail
FREESWITCH_RECORDINGS_PATH=/var/lib/pbxsense-agent/freeswitch/recordings
# Docker host root: cdr/, voicemail/, recordings/.
FREESWITCH_FILES_HOST_PATH=/var/lib/docker/volumes/fusionpbx-docker_freeswitch_lib/_data

PBXSENSE_RELAY_STATE_KEY=MVRzh6naWXaE1ULGiIffEh8KBp8INWxG7sEcTqQfiT4

PBXSENSE_BROWSER_BOOTSTRAP_TOKEN=Zt5SyfWJWCJdxl7-bcT6HlLy6y8mofXO
PBXSENSE_BROWSER_BOOTSTRAP_EXPIRES_AT=1791655892
